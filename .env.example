# ===== LLM（任选其一；都不配则运行在“模板模式”，仍可演示全链路）=====
# openai_compat 兼容 DeepSeek / Qwen(DashScope) / Kimi / GLM / OpenAI / OpenRouter 等
LLM_PROVIDER=openai_compat            # openai_compat | anthropic | none
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 价格（美元 / 百万 token），仅用于成本估算
LLM_PRICE_INPUT_PER_M=0.27
LLM_PRICE_OUTPUT_PER_M=1.10

# 备用模型（可选；主模型失败时自动切换）
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ===== 扶摇金融数据 API =====
# 在 https://fuyao.aicubes.cn/admin/ 用同花顺账号登录后签发 API Key
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn
# auto：有 Key 走真实接口，无 Key 用本地演示数据（证据会标注“演示数据”）；live / fixture 强制指定
FUYAO_MODE=auto

# ===== iFinD MCP（可选）=====
# 登录 iFinD 终端 / https://mcp.51ifind.com 「一键复制」MCP 配置，填入 URL 与 Authorization 头的值
IFIND_MCP_URL=
IFIND_MCP_AUTHORIZATION=

# ===== Harness 预算与策略默认值（UI 可覆盖）=====
HARNESS_MAX_LLM_STEPS=40
HARNESS_MAX_TOOL_CALLS=60
HARNESS_MAX_COST_USD=0.50
HARNESS_MAX_DURATION_S=600
HARNESS_CONTEXT_BUDGET_TOKENS=24000
HARNESS_PLAN_APPROVAL=auto            # always | auto | never
HARNESS_MEMORY_WRITE_APPROVAL=true

# ===== 服务 =====
PORT=8000
DATA_DIR=./data
LOG_LEVEL=INFO
ENABLE_FAULT_INJECTION=true           # 演示用：允许通过 UI 注入工具/模型故障
